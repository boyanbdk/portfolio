---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="what-i-do" class="section" aria-labelledby="services-heading">
  <div class="shell">
    <header class="services__head reveal">
      <div>
        <span class="eyebrow">{t('services.eyebrow')}</span>
        <h2 id="services-heading">{t('services.title')}</h2>
      </div>
      <p class="services__lede">{t('services.lede')}</p>
    </header>

    <div class="bento">
      <!-- Websites — the large, lead cell (§5) -->
      <article class="card svc svc--lead reveal">
        <span class="svc__ghost" aria-hidden="true">01</span>
        <div class="svc__top">
          <span class="svc__index" aria-hidden="true">01</span>
          <span class="svc__tag">{t('services.websites.tag')}</span>
        </div>

        <!-- editorial blueprint sketch: a page being built, cursor on the CTA -->
        <svg class="svc__motif svc__motif--lead" viewBox="0 0 260 170" fill="none" aria-hidden="true">
          <rect x="1.5" y="1.5" width="257" height="167" rx="12" stroke="currentColor" opacity="0.5" />
          <line x1="1.5" y1="30" x2="258.5" y2="30" stroke="currentColor" opacity="0.4" />
          <circle cx="17" cy="16" r="3" stroke="currentColor" opacity="0.5" />
          <circle cx="31" cy="16" r="3" stroke="currentColor" opacity="0.5" />
          <circle cx="45" cy="16" r="3" stroke="currentColor" opacity="0.5" />
          <rect x="64" y="9" width="96" height="14" rx="7" stroke="currentColor" opacity="0.35" />
          <rect x="24" y="52" width="132" height="14" rx="3" fill="currentColor" opacity="0.45" />
          <rect x="24" y="74" width="92" height="14" rx="3" fill="currentColor" opacity="0.3" />
          <line x1="24" y1="108" x2="172" y2="108" stroke="currentColor" opacity="0.4" />
          <line x1="24" y1="120" x2="148" y2="120" stroke="currentColor" opacity="0.4" />
          <rect class="svc__accent-stroke" x="24" y="134" width="64" height="20" rx="10" />
          <path class="svc__accent-fill" d="M84 142l9 22 3.5-8.5 8.5-3.5z" />
          <path class="svc__dash" d="M96 144c44 0 74-22 118-52" stroke-dasharray="4 5" />
          <circle class="svc__accent-fill" cx="216" cy="90" r="3.5" />
        </svg>

        <h3>{t('services.websites.title')}</h3>
        <p>{t('services.websites.body')}</p>

        <ul class="svc__list" role="list">
          <li>{t('services.websites.d1')}</li>
          <li>{t('services.websites.d2')}</li>
          <li>{t('services.websites.d3')}</li>
        </ul>
        <span class="svc__time">→ {t('services.websites.time')}</span>
      </article>

      <article class="card svc reveal">
        <span class="svc__ghost" aria-hidden="true">02</span>
        <div class="svc__top">
          <span class="svc__index" aria-hidden="true">02</span>
          <!-- dashboard sketch: sidebar, stat blocks, one line that trends up -->
          <svg class="svc__motif svc__motif--small" viewBox="0 0 220 150" fill="none" aria-hidden="true">
            <rect x="1.5" y="1.5" width="217" height="147" rx="12" stroke="currentColor" opacity="0.5" />
            <line x1="58" y1="1.5" x2="58" y2="148.5" stroke="currentColor" opacity="0.4" />
            <rect class="svc__accent-fill" x="14" y="20" width="30" height="6" rx="2" opacity="0.85" />
            <line x1="14" y1="42" x2="44" y2="42" stroke="currentColor" opacity="0.45" />
            <line x1="14" y1="58" x2="44" y2="58" stroke="currentColor" opacity="0.45" />
            <rect x="72" y="18" width="42" height="20" rx="4" stroke="currentColor" opacity="0.45" />
            <rect x="122" y="18" width="42" height="20" rx="4" stroke="currentColor" opacity="0.45" />
            <polyline points="72,112 96,90 116,98 138,68 160,76 198,42" stroke="currentColor" opacity="0.6" />
            <circle class="svc__accent-fill" cx="198" cy="42" r="3.5" />
            <line x1="72" y1="126" x2="204" y2="126" stroke="currentColor" opacity="0.35" />
          </svg>
        </div>
        <h3>{t('services.apps.title')}</h3>
        <p>{t('services.apps.body')}</p>
        <ul class="svc__list" role="list">
          <li>{t('services.apps.d1')}</li>
          <li>{t('services.apps.d2')}</li>
          <li>{t('services.apps.d3')}</li>
        </ul>
        <span class="svc__time">→ {t('services.apps.time')}</span>
      </article>

      <article class="card svc reveal">
        <span class="svc__ghost" aria-hidden="true">03</span>
        <div class="svc__top">
          <span class="svc__index" aria-hidden="true">03</span>
          <!-- flow sketch: two sources piped through an agent into one output -->
          <svg class="svc__motif svc__motif--small" viewBox="0 0 220 150" fill="none" aria-hidden="true">
            <rect x="10" y="24" width="52" height="34" rx="8" stroke="currentColor" opacity="0.5" />
            <line x1="20" y1="37" x2="52" y2="37" stroke="currentColor" opacity="0.45" />
            <line x1="20" y1="46" x2="44" y2="46" stroke="currentColor" opacity="0.45" />
            <rect x="10" y="92" width="52" height="34" rx="8" stroke="currentColor" opacity="0.5" />
            <line x1="20" y1="105" x2="52" y2="105" stroke="currentColor" opacity="0.45" />
            <line x1="20" y1="114" x2="44" y2="114" stroke="currentColor" opacity="0.45" />
            <circle cx="118" cy="75" r="17" stroke="currentColor" opacity="0.6" />
            <circle class="svc__accent-fill svc__pulse" cx="118" cy="75" r="4.5" />
            <path class="svc__dash" d="M62 41c26 0 32 22 40 27" stroke-dasharray="4 5" />
            <path class="svc__dash" d="M62 109c26 0 32-22 40-27" stroke-dasharray="4 5" />
            <path class="svc__dash" d="M135 75h32" stroke-dasharray="4 5" />
            <path d="M162 70l9 5-9 5z" fill="currentColor" opacity="0.6" />
            <rect x="173" y="58" width="40" height="34" rx="8" stroke="currentColor" opacity="0.5" />
            <path class="svc__accent-stroke" d="M184 75l5 5 10-10" />
          </svg>
        </div>
        <h3>{t('services.automations.title')}</h3>
        <p>{t('services.automations.body')}</p>
        <ul class="svc__list" role="list">
          <li>{t('services.automations.d1')}</li>
          <li>{t('services.automations.d2')}</li>
          <li>{t('services.automations.d3')}</li>
        </ul>
        <span class="svc__time">→ {t('services.automations.time')}</span>
      </article>
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .services__head h2 {
    /* heavier presence: this heading anchors the first chapter */
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    margin-top: 0.75rem;
    max-width: 24ch;
  }
  .services__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--color-ink-mute);
    max-width: 30ch;
    margin-bottom: 0.4rem;
  }

  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  /* Uneven weights: Websites spans both rows on the left; the other two stack right. */
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: repeat(2, auto);
    }
    .svc--lead {
      grid-row: 1 / span 2;
    }
  }

  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .svc:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  /* oversized ghost numeral — print-magazine folio mark */
  .svc__ghost {
    position: absolute;
    top: -0.18em;
    right: 0.05em;
    opacity: 0.05;
  }
  /* small cells carry their sketch top-right, so the folio mark drops to the foot */
  .svc:not(.svc--lead) .svc__ghost {
    top: auto;
    bottom: -0.22em;
    right: 0.08em;
  }
  .svc__ghost {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(6rem, 12vw, 9.5rem);
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  .svc__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .svc__index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    padding-top: 0.3rem;
  }
  .svc__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  /* ── blueprint motifs ── */
  .svc__motif {
    color: color-mix(in srgb, var(--color-ink-soft) 88%, var(--color-canvas-alt));
    stroke-width: 1.4;
  }
  .svc__motif--lead {
    width: min(19rem, 78%);
    margin: 0.5rem 0 1.75rem;
  }
  .svc__motif--small {
    width: 8.5rem;
    flex-shrink: 0;
    margin-top: -0.4rem;
  }
  .svc__accent-stroke {
    stroke: var(--color-accent);
    fill: none;
  }
  .svc__accent-fill {
    fill: var(--color-accent);
    stroke: none;
  }
  .svc__dash {
    stroke: var(--color-accent);
    fill: none;
    opacity: 0.7;
  }
  /* the sketches wake up on hover: dashes march, nothing glows */
  @media (prefers-reduced-motion: no-preference) {
    .svc:hover .svc__dash {
      animation: svc-march 1.4s linear infinite;
    }
  }
  @keyframes svc-march {
    to {
      stroke-dashoffset: -18;
    }
  }

  .svc h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    margin-bottom: 0.6rem;
  }
  .svc--lead h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
  }
  .svc p {
    color: var(--color-ink-soft);
    max-width: 42ch;
  }
  .svc--lead p {
    font-size: 1.125rem;
    max-width: 36ch;
  }

  /* mono deliverables — the concrete "what you get" */
  .svc__list {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line);
  }
  .svc__list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
  }
  .svc__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  .svc__time {
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
  }
  .svc:hover .svc__time {
    color: var(--color-accent);
  }

  .svc--lead {
    border-top: 3px solid var(--color-accent); /* the one cell that leads */
    min-height: 24rem;
  }
</style>
