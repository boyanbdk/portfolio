---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="what-i-do" class="section" aria-labelledby="services-heading">
  <div class="shell">
    <header class="services__head reveal">
      <span class="eyebrow">{t('services.eyebrow')}</span>
      <h2 id="services-heading">{t('services.title')}</h2>
    </header>

    <div class="bento">
      <!-- Websites — the large, lead cell (§5) -->
      <article class="card bento__lead reveal">
        <span class="bento__index" aria-hidden="true">01</span>
        <span class="bento__tag">{t('services.websites.tag')}</span>
        <h3>{t('services.websites.title')}</h3>
        <p>{t('services.websites.body')}</p>
      </article>

      <article class="card bento__cell reveal">
        <span class="bento__index" aria-hidden="true">02</span>
        <h3>{t('services.apps.title')}</h3>
        <p>{t('services.apps.body')}</p>
      </article>

      <article class="card bento__cell reveal">
        <span class="bento__index" aria-hidden="true">03</span>
        <h3>{t('services.automations.title')}</h3>
        <p>{t('services.automations.body')}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    max-width: 24ch;
  }
  .services__head h2 {
    /* heavier presence: this heading anchors the first cream chapter */
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
  }

  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  /* Uneven weights: Websites spans both rows on the left; the other two stack right. */
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: repeat(2, 1fr);
    }
    .bento__lead {
      grid-row: 1 / span 2;
    }
  }

  .bento article {
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .bento article:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .bento__index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    margin-bottom: 1rem;
  }
  .bento__tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.9rem;
  }
  .bento h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    margin-bottom: 0.6rem;
  }
  .bento__lead h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }
  .bento p {
    color: var(--color-ink-soft);
    max-width: 42ch;
  }
  .bento__lead {
    justify-content: flex-start;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    min-height: 24rem;
    border-top: 3px solid var(--color-accent); /* the one cell that leads */
  }
  .bento__lead p {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 36ch;
  }
</style>
