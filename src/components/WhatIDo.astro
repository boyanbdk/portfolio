---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Four steps of how Boyan builds with AI; each ends on a line of proof.
const steps = [
  { key: 'spec' },
  { key: 'build', href: localizePath(lang, '/work/disciplis') },
  { key: 'review' },
  { key: 'run', href: localizePath(lang, '/clients/binko') },
] as const;
---

<section id="what-i-do" class="section" aria-labelledby="services-heading">
  <div class="shell">
    <header class="services__head reveal">
      <div>
        <span class="eyebrow">{t('services.eyebrow')}</span>
        <!-- single line: Astro drops newline-only whitespace between expressions -->
        <h2 id="services-heading">{t('services.title.pre')} <span data-scribble="underline">{t('services.title.mark')}</span></h2>
      </div>
      <p class="services__lede">{t('services.lede')}</p>
    </header>

    <ol class="steps" role="list">
      {
        steps.map((step, i) => (
          <li class="card svc" data-svc-seq={i + 1}>
            <span class="svc__ghost" aria-hidden="true">0{i + 1}</span>
            <span class="svc__index" aria-hidden="true">0{i + 1}</span>
            <h3>{t(`how.${step.key}.title`)}</h3>
            <p>{t(`how.${step.key}.body`)}</p>
            {step.href ? (
              <a href={step.href} class="svc__time svc__proof">→ {t(`how.${step.key}.proof`)}</a>
            ) : (
              <span class="svc__time svc__proof">→ {t(`how.${step.key}.proof`)}</span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .services__head h2 {
    /* heavier presence: this heading anchors the first chapter */
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    margin-top: 0.75rem;
    max-width: 24ch;
  }
  .services__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--color-ink-mute);
    max-width: 30ch;
    margin-bottom: 0.4rem;
  }

  .steps {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .svc:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  /* oversized ghost numeral — print-magazine folio mark */
  .svc__ghost {
    position: absolute;
    top: -0.18em;
    right: 0.05em;
    opacity: 0.05;
  }
  .svc__ghost {
    top: auto;
    bottom: -0.22em;
    right: 0.08em;
  }
  .svc__ghost {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(6rem, 12vw, 9.5rem);
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  .svc__index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1.1rem;
  }

  .svc h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    margin-bottom: 0.6rem;
  }
  .svc p {
    color: var(--color-ink-soft);
  }

  .svc__time {
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
  }
  .svc:hover .svc__time {
    color: var(--color-accent);
  }

  .svc__proof {
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }
</style>
