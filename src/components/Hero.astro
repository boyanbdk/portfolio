---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { tools } from '../data/tools';
import { site } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      poster="/hero-agents-poster.jpg"
      width="1920"
      height="1080"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      data-hero-video
    >
      <!-- phones get the vertical cut (its bubbles are unreadable in a 16:9 strip); keep the query in sync with the CSS and script below -->
      <source src="/hero-agents-9x16.mp4" type="video/mp4" media="(max-width: 699px)" />
      <source src="/hero-agents.mp4" type="video/mp4" />
    </video>
    <div class="hero__fade"></div>
  </div>

  <div class="shell hero__content">
    <div class="hero__lead">
      <span class="eyebrow hero__eyebrow" data-hero-rise>{t('hero.eyebrow')}</span>

      <h1 id="hero-heading" class="hero__headline">
        <span class="hero__line"><span class="hero__line-inner" data-hero-line>{t('hero.headline.1')}</span></span>
        <span class="hero__line"
          ><span class="hero__line-inner" data-hero-line
            ><span class="accent-italic hero__eq">{t('hero.headline.accent')}</span>{' '}{t('hero.headline.2')}</span
          ></span
        >
      </h1>
    </div>

    <div class="hero__side">
      <p class="hero__sub" data-hero-rise>
        <span class="sr-only">{t('hero.sub')}</span>
        <span aria-hidden="true" class="hero__sub-visual">
          <span class="hero__sub-slot" data-rotate-words>
            <span class="hero__sub-word">{t('hero.sub.w1')}</span>
            <span class="hero__sub-word">{t('hero.sub.w2')}</span>
            <span class="hero__sub-word">{t('hero.sub.w3')}</span>
          </span>
          {' '}{t('hero.sub.tail')}
        </span>
      </p>

      <div class="hero__cta" data-hero-rise>
        <a href={site.cv[lang]} class="btn hero__btn" download>{t('hero.cta')} <span aria-hidden="true">↓</span></a>
        <a href="#work" class="hero__secondary">{t('hero.secondary')}</a>
      </div>
    </div>
  </div>

  <!-- Tool-logo marquee — two identical groups create the seamless loop -->
  <div class="hero__strip" data-hero-strip aria-label={`${t('hero.tools')}: ${tools.filter((x) => !x.primary).map((x) => x.name).join(', ')}`}>
    <div class="hero__marquee">
      {
        [0, 1].map((clone) => (
          <div class="hero__marquee-group" aria-hidden={clone > 0 || undefined}>
            {tools.map((tool) => (
              <span class:list={['hero__strip-item', { 'hero__strip-item--primary': tool.primary }]}>
                {tool.path ? (
                  <svg class="hero__logo" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={tool.path} />
                  </svg>
                ) : (
                  <span class="hero__logo hero__logo--glyph" aria-hidden="true">&gt;_</span>
                )}
                {tool.name}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Honor prefers-reduced-motion: hold the loop on its first frame.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && window.matchMedia('(max-width: 699px)').matches) video.poster = '/hero-agents-9x16-poster.jpg';
  function applyMotionPref() {
    if (!video) return;
    if (reduced.matches) {
      video.pause();
      video.currentTime = 0;
    } else {
      video.play().catch(() => {});
    }
  }
  applyMotionPref();
  reduced.addEventListener('change', applyMotionPref);
  video?.addEventListener('loadeddata', applyMotionPref, { once: true });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── the video stage: full-bleed 16:9. On short screens it gives up height so the headline row stays
     above the fold; the crop comes mostly off the bottom, which is only falling code ── */
  .hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100svh - 12rem);
    overflow: hidden;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }
  /* phones: the 9:16 cut, tall enough for its bubbles; the headline follows below */
  @media (max-width: 699px) {
    .hero__media {
      aspect-ratio: 9 / 16;
      max-height: calc(100svh - 6rem);
    }
  }
  /* the bottom edge (only falling code in every shot) melts into the page, under the headline */
  .hero__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-canvas) 0%, color-mix(in srgb, var(--color-canvas) 0%, transparent) 16%);
    pointer-events: none;
  }

  /* ── content: a row under the stage, overlapping only its faded edge ── */
  .hero__content {
    position: relative;
    width: 100%;
    max-width: var(--spacing-shell);
    margin-top: calc(-1 * clamp(2rem, 5vw, 4.5rem));
    padding-block: 0 4rem; /* room for the tool strip */
    color: var(--color-ink);
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 900px) {
    .hero__content {
      grid-template-columns: 1.45fr 1fr;
      align-items: end;
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }
  .hero__eyebrow {
    color: color-mix(in srgb, var(--color-accent) 55%, #fff);
  }
  .hero__headline {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3vw, 2.9rem);
    color: #fff;
    text-shadow: 0 1px 30px rgba(0, 0, 0, 0.3);
  }
  /* masked line reveal: outer clips, inner rises from below the fold line */
  .hero__line {
    display: block;
    overflow: hidden;
    /* keep descenders (y, g) from clipping at rest */
    margin-block: -0.12em;
    padding-block: 0.12em;
  }
  .hero__line-inner {
    display: block;
    will-change: transform;
  }

  /* ── pre-paint guard (html.motion-pending set inline in <head>) ──
     Mirrors the GSAP intro's from-states so there is no flash before boot. */
  :global(html.motion-pending) .hero__line-inner {
    transform: translateY(110%);
  }
  :global(html.motion-pending) .hero__eyebrow,
  :global(html.motion-pending) .hero__sub,
  :global(html.motion-pending) .hero__cta {
    opacity: 0;
  }
  :global(html.motion-pending) .hero__video {
    opacity: 0;
  }
  :global(html.motion-pending) .hero__strip {
    transform: translateY(100%);
  }
  .hero__eq {
    color: color-mix(in srgb, var(--color-accent) 62%, #fff);
  }
  .hero__sub {
    max-width: 40ch;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-ink) 84%, transparent);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  /* cream button pops on the dark image */
  .hero__btn {
    background: var(--color-ink);
    color: var(--color-on-accent);
    border-color: var(--color-ink);
  }
  .hero__btn:hover {
    opacity: 1;
    background: #fff;
  }
  .hero__secondary {
    font-size: 0.95rem;
    color: var(--color-ink);
    position: relative;
  }
  .hero__secondary::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .hero__secondary:hover::after {
    transform: scaleX(1);
  }

  /* ── bottom facts strip (Argus-style) ── */
  .hero__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-shade) 55%, transparent);
    backdrop-filter: blur(6px);
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }
  .hero__marquee {
    display: flex;
    width: max-content;
    will-change: transform; /* own compositor layer → no jank over the blur */
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    white-space: nowrap;
  }
  .hero__marquee-group {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding-block: 0.85rem;
    padding-inline-end: clamp(1.5rem, 3vw, 2.75rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__marquee {
      /* 2 identical groups; shifting one group width (-50%) = seamless */
      animation: heroMarquee 45s linear infinite;
    }
    .hero__strip:hover .hero__marquee {
      animation-play-state: paused;
    }
  }
  @keyframes heroMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .hero__strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hero__strip-item--primary {
    color: #fff;
  }
  .hero__logo {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    fill: color-mix(in srgb, var(--color-accent) 55%, #fff);
  }
  .hero__logo--glyph {
    display: inline-grid;
    place-items: center;
    font-size: 0.7rem;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--color-accent) 55%, #fff);
  }

</style>
