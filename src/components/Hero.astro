---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Manifesto marquee: phrases alternate texture (mono caps / italic serif)
// so the strip reads as a stream, not a stuck loop. Accent = olive highlights.
const marquee = [
  { key: 'hero.marquee.1', serif: false, accent: true },
  { key: 'hero.marquee.2', serif: true, accent: false },
  { key: 'hero.marquee.3', serif: false, accent: false },
  { key: 'hero.marquee.4', serif: true, accent: false },
  { key: 'hero.marquee.5', serif: false, accent: false },
  { key: 'hero.marquee.6', serif: true, accent: true },
  { key: 'hero.marquee.7', serif: false, accent: false },
] as const;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      src="/hero-desk.mp4"
      width="1280"
      height="720"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      data-hero-video
    ></video>
    <div class="hero__edges"></div>
    <div class="hero__scrim"></div>
  </div>

  <div class="shell hero__content">
    <span class="eyebrow hero__eyebrow">{t('hero.eyebrow')}</span>

    <h1 id="hero-heading" class="hero__headline">
      {t('hero.headline.1')}{' '}
      <span class="accent-italic hero__eq">{t('hero.headline.accent')}</span>{' '}
      {t('hero.headline.2')}
    </h1>

    <p class="hero__sub">{t('hero.sub')}</p>

    <div class="hero__cta">
      <a href="#contact" class="btn hero__btn">{t('hero.cta')} <span aria-hidden="true">→</span></a>
      <a href="#work" class="hero__secondary">{t('hero.secondary')}</a>
    </div>
  </div>

  <!-- Infinite manifesto marquee — two identical groups create the seamless loop -->
  <div class="hero__strip" aria-label={marquee.map((m) => t(m.key)).join(' · ')}>
    <div class="hero__marquee">
      {
        [0, 1].map((clone) => (
          <div class="hero__marquee-group" aria-hidden={clone > 0 || undefined}>
            {marquee.map((m) => (
              <>
                <span
                  class="hero__strip-item"
                  class:list={{
                    'hero__strip-item--serif': m.serif,
                    'hero__strip-item--accent': m.accent,
                  }}
                >
                  {t(m.key)}
                </span>
                <span class="hero__strip-dot" aria-hidden="true">·</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Honor prefers-reduced-motion: hold the loop on its first frame.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  function applyMotionPref() {
    if (!video) return;
    if (reduced.matches) {
      video.pause();
      video.currentTime = 0;
    } else {
      video.play().catch(() => {});
    }
  }
  applyMotionPref();
  reduced.addEventListener('change', applyMotionPref);
  video?.addEventListener('loadeddata', applyMotionPref, { once: true });
</script>

<style>
  .hero {
    position: relative;
    min-height: clamp(34rem, 84vh, 50rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    /* break out of the page's inline padding to sit edge-to-edge */
    isolation: isolate;
  }

  /* ── background image ── */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right; /* keep the desk in frame, calm wall to the left */
    /* slight overscan crops the frame edges where the removed watermark ghosts */
    transform: scale(1.06);
    /* warm-paper grade so the footage lives in the palette */
    filter: saturate(0.94) contrast(1.02);
  }

  /* soft blur vignette: sharp centre, edges melt away (also buries watermark ghosts) */
  .hero__edges {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(14px);
    -webkit-mask-image: radial-gradient(130% 130% at 50% 45%, transparent 58%, #000 90%);
    mask-image: radial-gradient(130% 130% at 50% 45%, transparent 58%, #000 90%);
    pointer-events: none;
  }

  /* left-weighted scrim so cream text reads over the calm side */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(20, 17, 14, 0.82) 0%,
        rgba(20, 17, 14, 0.6) 26%,
        rgba(20, 17, 14, 0.12) 52%,
        rgba(20, 17, 14, 0) 70%
      ),
      linear-gradient(to top, rgba(20, 17, 14, 0.55) 0%, rgba(20, 17, 14, 0) 32%);
  }

  /* ── content (left third) ── */
  .hero__content {
    position: relative;
    width: 100%;
    max-width: var(--spacing-shell);
    padding-block: clamp(2rem, 6vw, 4rem);
    color: var(--color-ink);
  }
  .hero__eyebrow {
    color: color-mix(in srgb, var(--color-accent) 55%, #fff);
  }
  .hero__headline {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    max-width: 15ch;
    color: #fff;
    text-shadow: 0 1px 30px rgba(0, 0, 0, 0.3);
  }
  .hero__eq {
    color: color-mix(in srgb, var(--color-accent) 62%, #fff);
  }
  .hero__sub {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-ink) 84%, transparent);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  /* cream button pops on the dark image */
  .hero__btn {
    background: var(--color-ink);
    color: var(--color-on-accent);
    border-color: var(--color-ink);
  }
  .hero__btn:hover {
    opacity: 1;
    background: #fff;
  }
  .hero__secondary {
    font-size: 0.95rem;
    color: var(--color-ink);
    position: relative;
  }
  .hero__secondary::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .hero__secondary:hover::after {
    transform: scaleX(1);
  }

  /* ── bottom facts strip (Argus-style) ── */
  .hero__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-shade) 55%, transparent);
    backdrop-filter: blur(6px);
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }
  .hero__marquee {
    display: flex;
    width: max-content;
    will-change: transform; /* own compositor layer → no jank over the blur */
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    white-space: nowrap;
  }
  .hero__marquee-group {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding-block: 0.85rem;
    padding-inline-end: clamp(1.5rem, 3vw, 2.75rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__marquee {
      /* 2 identical groups; shifting one group width (-50%) = seamless */
      animation: heroMarquee 45s linear infinite;
    }
    .hero__strip:hover .hero__marquee {
      animation-play-state: paused;
    }
  }
  @keyframes heroMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .hero__strip-dot {
    color: color-mix(in srgb, var(--color-accent) 60%, #fff);
  }
  .hero__strip-item--serif {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .hero__strip-item--accent {
    color: color-mix(in srgb, var(--color-accent) 62%, #fff);
  }
  .hero__strip-badge {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-accent) 55%, #fff);
  }
  .hero__strip-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .hero__strip-k {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  @media (max-width: 640px) {
    /* darken more evenly on tall mobile crops so text stays legible anywhere */
    .hero__scrim {
      background: linear-gradient(
        to top,
        rgba(20, 17, 14, 0.85) 0%,
        rgba(20, 17, 14, 0.5) 45%,
        rgba(20, 17, 14, 0.35) 100%
      );
    }
    .hero__img {
      object-position: center;
    }
  }
</style>
