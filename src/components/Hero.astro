---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="shell hero__inner">
    <div class="hero__lead">
      <div class="hero__meta">
        <span class="eyebrow">{t('hero.eyebrow')}</span>
        <span class="eyebrow hero__meta-right">{t('hero.location')}</span>
      </div>

      <h1 id="hero-heading" class="hero__headline">
        {t('hero.headline.1')}{' '}
        <span class="accent-italic">{t('hero.headline.accent')}</span>{' '}
        {t('hero.headline.2')}
      </h1>

      <p class="hero__sub">{t('hero.sub')}</p>

      <div class="hero__cta">
        <a href="#contact" class="btn">{t('hero.cta')} <span aria-hidden="true">→</span></a>
        <a href="#work" class="link hero__secondary">{t('hero.secondary')}</a>
      </div>
    </div>

    <!-- Editorial info panel — swap for a real portrait when supplied (DESIGN.md §5) -->
    <aside class="hero__panel" aria-label="At a glance">
      <span class="hero__available">
        <span class="hero__pulse" aria-hidden="true"></span>
        {t('hero.available')}
      </span>
      <dl class="hero__facts">
        <div>
          <dt>Focus</dt>
          <dd>Websites · Web apps · Automations</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>Next.js · Astro · Supabase · AI tooling</dd>
        </div>
        <div>
          <dt>Based</dt>
          <dd>Bulgaria — working EN / BG</dd>
        </div>
      </dl>
      <span class="hero__monogram" aria-hidden="true">BB</span>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 60fr 40fr;
      align-items: center;
    }
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .hero__meta-right {
    text-align: right;
  }

  .hero__headline {
    font-size: var(--text-hero);
    max-width: 14ch;
  }

  .hero__sub {
    margin-top: 1.5rem;
    max-width: 46ch;
    color: var(--color-ink-soft);
    font-size: 1.125rem;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  .hero__secondary {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  /* info panel */
  .hero__panel {
    position: relative;
    overflow: hidden;
    background: var(--color-canvas-alt);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: 0 18px 40px -30px rgba(26, 23, 20, 0.45);
  }

  .hero__available {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .hero__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__pulse {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 45%, transparent);
    }
    50% {
      opacity: 0.7;
      box-shadow: 0 0 0 6px transparent;
    }
  }

  .hero__facts {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.1rem;
  }
  .hero__facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    margin-bottom: 0.2rem;
  }
  .hero__facts dd {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .hero__monogram {
    position: absolute;
    right: -0.75rem;
    bottom: -2.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 9rem;
    line-height: 1;
    color: var(--color-line);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }
</style>
