---
// Faithful recreation of the Disciplis product UI (its own brand: dark #0A0E17,
// teal→cyan #00E0C3→#00B4D8, Discipline Score gauge + sparkline). No real
// screenshot export exists, so this is rebuilt from the product's design tokens.
const data = [62, 65, 58, 71, 68, 74, 72, 79, 83, 81, 85, 88];
const w = 340;
const h = 76;
const pad = 6;
const min = Math.min(...data);
const max = Math.max(...data);
const pts = data
  .map((v, i) => {
    const x = pad + (i / (data.length - 1)) * (w - 2 * pad);
    const y = pad + (1 - (v - min) / (max - min)) * (h - 2 * pad);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
const areaPts = `${pad},${h - pad} ${pts} ${w - pad},${h - pad}`;

const tags = ['calm', 'focused', 'FOMO', 'revenge trade', 'tilted', 'broke rules'];
---

<div class="dsc" role="img" aria-label="Disciplis product interface: a Discipline Score of 88 out of 100 trending up, with behavioural tags and session tracking.">
  <!-- top bar -->
  <div class="dsc__bar">
    <span class="dsc__brand">
      <svg class="dsc__mark" viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="dscMark" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00E0C3"></stop>
            <stop offset="100%" stop-color="#00B4D8"></stop>
          </linearGradient>
        </defs>
        <rect x="8" y="8" width="48" height="48" rx="4" stroke="url(#dscMark)" stroke-width="2" fill="none" opacity="0.3"></rect>
        <rect x="20" y="20" width="24" height="4" rx="2" fill="url(#dscMark)" opacity="0.6"></rect>
        <rect x="20" y="30" width="24" height="4" rx="2" fill="url(#dscMark)"></rect>
        <rect x="20" y="40" width="24" height="4" rx="2" fill="url(#dscMark)" opacity="0.6"></rect>
        <circle cx="32" cy="32" r="3" fill="#00E0C3"></circle>
      </svg>
      <span class="dsc__word">Disciplis</span>
    </span>
    <span class="dsc__live"><span class="dsc__dot" aria-hidden="true"></span>Live session tracking</span>
  </div>

  <!-- discipline score -->
  <div class="dsc__scoreRow">
    <div>
      <span class="dsc__label">Discipline score</span>
      <span class="dsc__score">88<span class="dsc__of">/100</span></span>
    </div>
    <span class="dsc__delta">
      <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M5 8V2M2 5l3-3 3 3" stroke="#00E0C3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      12% this month
    </span>
  </div>

  <!-- sparkline -->
  <svg class="dsc__spark" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="dscArea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#00E0C3" stop-opacity="0.28"></stop>
        <stop offset="100%" stop-color="#00E0C3" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <polygon points={areaPts} fill="url(#dscArea)"></polygon>
    <polyline points={pts} fill="none" stroke="#00E0C3" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"></polyline>
  </svg>

  <!-- behavioural tags -->
  <div class="dsc__tags">
    {tags.map((tag) => <span class="dsc__tag">{tag}</span>)}
  </div>

  <!-- mini stats -->
  <div class="dsc__stats">
    <div class="dsc__stat">
      <span class="dsc__statVal">Tilt · low</span>
      <span class="dsc__statLabel">state signal</span>
    </div>
    <div class="dsc__stat">
      <span class="dsc__statVal">6-day</span>
      <span class="dsc__statLabel">reflection streak</span>
    </div>
    <div class="dsc__stat">
      <span class="dsc__statVal">Rules 9/10</span>
      <span class="dsc__statLabel">adherence</span>
    </div>
  </div>
</div>

<style>
  .dsc {
    --teal: #00e0c3;
    --teal-2: #00b4d8;
    width: 100%;
    max-width: 30rem;
    background: linear-gradient(180deg, #0d1220 0%, #0a0e17 100%);
    border: 1px solid rgba(0, 224, 195, 0.18);
    border-radius: 18px;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    box-shadow:
      0 40px 80px -50px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      0 30px 60px -40px rgba(0, 224, 195, 0.25);
    color: #fff;
    font-family: var(--font-body);
  }

  .dsc__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .dsc__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dsc__mark {
    width: 26px;
    height: 26px;
  }
  .dsc__word {
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 0.95rem;
  }
  .dsc__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }
  .dsc__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 8px var(--teal);
  }

  .dsc__scoreRow {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.1rem;
  }
  .dsc__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.35rem;
  }
  .dsc__score {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 8vw, 3.2rem);
    line-height: 1;
    background: linear-gradient(120deg, #fff, #d8fff8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .dsc__of {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.25);
    margin-left: 0.1rem;
  }
  .dsc__delta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--teal);
    background: rgba(0, 224, 195, 0.1);
    border: 1px solid rgba(0, 224, 195, 0.2);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .dsc__spark {
    width: 100%;
    height: 64px;
    margin-top: 0.5rem;
    display: block;
  }

  .dsc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .dsc__tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
  }
  /* highlight the "problem" behaviours in teal to read at a glance */
  .dsc__tag:nth-child(3),
  .dsc__tag:nth-child(4),
  .dsc__tag:nth-child(5) {
    color: var(--teal);
    background: rgba(0, 224, 195, 0.08);
    border-color: rgba(0, 224, 195, 0.22);
  }

  .dsc__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .dsc__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dsc__statVal {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }
  .dsc__statLabel {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.35);
  }
</style>
