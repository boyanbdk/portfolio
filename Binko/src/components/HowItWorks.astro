---
const steps = [
  {
    number: '01',
    title: 'Безплатен оглед',
    description: 'Идваме на място, оценяваме потока от хора и препоръчваме най-подходящата машина.',
  },
  {
    number: '02',
    title: 'Монтаж до 7 дни',
    description: 'Доставяме и свързваме машината без прекъсване на работата във вашия обект.',
  },
  {
    number: '03',
    title: 'Редовно зареждане',
    description: 'Кафе, чаши, закуски и напитки — следим наличностите, за да е машината винаги пълна.',
  },
  {
    number: '04',
    title: 'Постоянна поддръжка',
    description: 'Грижим се за почистването и сервиза с реакция под 24 часа при възникнал проблем.',
  },
];
---

<section id="kak-raboti" class="bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-3xl">
      <p class="label reveal">Как работи</p>
      <h2 class="display reveal mt-5 text-3xl md:text-5xl">
        От първия оглед до всяка следваща чаша.
      </h2>
    </div>

    <div class="relative mt-12 grid gap-10 md:mt-16 md:grid-cols-4 md:gap-8">
      <div class="absolute left-[12.5%] right-[12.5%] top-7 hidden h-px bg-sand md:block" aria-hidden="true"></div>

      {steps.map((step) => (
        <article class="reveal relative">
          <p class="relative z-10 inline-block bg-paper pr-4 font-display text-4xl font-semibold text-accent md:text-5xl">
            {step.number}
          </p>
          <h3 class="mt-6 font-display text-lg font-semibold">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
