---
---

<section id="kontakt" class="bg-ink py-20 text-cream md:py-28">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:px-8">
    <div class="reveal">
      <p class="label">Контакт</p>
      <h2 class="display mt-5 text-3xl md:text-5xl">Заявете безплатен оглед</h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-cream/70">
        Разкажете ни накратко за вашия обект. Ще се свържем с вас, за да обсъдим подходящата машина и следващите стъпки.
      </p>

      <div class="mt-10 space-y-5">
        <a href="tel:+359880000000" class="group flex items-center gap-4 text-sm transition-colors hover:text-accent">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/15 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7.2 3.5 9.8 8 7.7 9.7c1.2 2.6 3.3 4.7 5.9 5.9l1.7-2.1 4.5 2.6-.8 3.2c-.2.8-.9 1.3-1.7 1.3C9.7 20.6 3.4 14.3 3.4 6.7c0-.8.5-1.5 1.3-1.7l2.5-.6Z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>
            <span class="block text-xs uppercase tracking-[0.14em] text-cream/45">Телефон</span>
            <span class="mt-1 block font-semibold">+359 88 000 0000</span>
          </span>
        </a>

        <a href="mailto:office@binkovending.com" class="group flex items-center gap-4 text-sm transition-colors hover:text-accent">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/15 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>
            <span class="block text-xs uppercase tracking-[0.14em] text-cream/45">Имейл</span>
            <span class="mt-1 block font-semibold">office@binkovending.com</span>
          </span>
        </a>
      </div>
    </div>

    <form name="contact" method="POST" action="#" class="reveal rounded-3xl border border-cream/10 bg-cream/5 p-6 md:p-8">
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Име</span>
          <input type="text" name="name" autocomplete="name" required placeholder="Вашето име" class="mt-2 w-full rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream placeholder-cream/40 outline-none transition-colors focus:border-accent" />
        </label>

        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Фирма</span>
          <input type="text" name="company" autocomplete="organization" required placeholder="Име на фирмата" class="mt-2 w-full rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream placeholder-cream/40 outline-none transition-colors focus:border-accent" />
        </label>

        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Град</span>
          <input type="text" name="city" autocomplete="address-level2" required placeholder="Напр. София" class="mt-2 w-full rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream placeholder-cream/40 outline-none transition-colors focus:border-accent" />
        </label>

        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Телефон</span>
          <input type="tel" name="phone" autocomplete="tel" required placeholder="+359…" class="mt-2 w-full rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream placeholder-cream/40 outline-none transition-colors focus:border-accent" />
        </label>

        <label class="block sm:col-span-2">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Тип обект</span>
          <select name="venue_type" required class="mt-2 w-full rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream outline-none transition-colors focus:border-accent">
            <option value="" disabled selected class="text-ink">Изберете тип обект</option>
            <option value="office" class="text-ink">Офис</option>
            <option value="fitness" class="text-ink">Фитнес</option>
            <option value="production" class="text-ink">Производство</option>
            <option value="school" class="text-ink">Учебно заведение</option>
            <option value="other" class="text-ink">Друго</option>
          </select>
        </label>

        <label class="block sm:col-span-2">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-cream/65">Съобщение <span class="normal-case tracking-normal text-cream/40">(по желание)</span></span>
          <textarea name="message" rows="4" placeholder="Споделете повече за обекта" class="mt-2 w-full resize-y rounded-xl border border-cream/20 bg-transparent px-4 py-3 text-cream placeholder-cream/40 outline-none transition-colors focus:border-accent"></textarea>
        </label>
      </div>

      <button type="submit" class="btn-primary mt-7 w-full justify-center">Изпратете запитване</button>
    </form>
  </div>
</section>
