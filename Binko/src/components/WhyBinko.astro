---
const benefits = [
  'Безплатен монтаж и без наем',
  'Безкасово плащане с карта',
  'Реакция под 24 часа',
  'Свежи продукти при всяко зареждане',
  'Договор без скрити такси',
  'Машини с гаранция и сертификати',
];
---

<section class="bg-cream py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[0.9fr_1.1fr] md:gap-20 md:px-8">
    <div>
      <p class="label reveal">Защо Binko</p>
      <h2 class="display reveal mt-5 text-3xl md:text-5xl">Защо обектите избират Binko</h2>
      <p class="reveal mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">
        Получавате надеждно вендинг решение без първоначална инвестиция и без излишна ангажираност.
        Ние поемаме ежедневната грижа, а вие печелите удобно обслужване за хората във вашия обект.
      </p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      {benefits.map((benefit) => (
        <li class="reveal flex items-start gap-4 rounded-2xl bg-paper p-5">
          <svg viewBox="0 0 24 24" class="mt-0.5 h-6 w-6 shrink-0 text-accent" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7" />
            <path d="m7.5 12.2 3 3 6-6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="font-display text-sm font-semibold leading-relaxed">{benefit}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
