---
const links = [
  { href: '#uslugi', label: 'Услуги' },
  { href: '#mashini', label: 'Машини' },
  { href: '#kak-raboti', label: 'Как работи' },
  { href: '#vaprosi', label: 'Въпроси' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink/8 bg-cream/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="#" class="font-display text-lg font-bold tracking-tight">
      BINKO<span class="text-accent">.</span>
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-ink-soft transition-colors hover:text-ink">
          {l.label}
        </a>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <a href="#kontakt" class="btn-primary !px-5 !py-2.5 text-xs md:text-sm">Заявете машина</a>
      <details class="relative md:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 [&::-webkit-details-marker]:hidden" aria-label="Меню">
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 1h14M1 6h14M1 11h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 flex w-48 flex-col gap-1 rounded-2xl border border-ink/10 bg-cream p-2 shadow-lg">
          {links.map((l) => (
            <a href={l.href} class="rounded-xl px-4 py-2.5 text-sm font-medium text-ink-soft hover:bg-paper hover:text-ink">
              {l.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu when a link inside it is tapped
  document.querySelectorAll('header details a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
</script>
