        <svg viewBox="0 0 200 260" class="h-4/5 w-auto" aria-hidden="true">
          <rect x="30" y="10" width="140" height="240" rx="10" fill="#2a241e" />
          <rect x="42" y="24" width="80" height="150" rx="6" fill="#0f0c0a" />
          <g fill="#e8500a">
            <rect x="50" y="34" width="26" height="34" rx="4" opacity="0.9" />
            <rect x="82" y="34" width="26" height="34" rx="4" opacity="0.6" />
            <rect x="50" y="76" width="26" height="34" rx="4" opacity="0.5" />
            <rect x="82" y="76" width="26" height="34" rx="4" opacity="0.8" />
            <rect x="50" y="118" width="26" height="34" rx="4" opacity="0.7" />
            <rect x="82" y="118" width="26" height="34" rx="4" opacity="0.45" />
